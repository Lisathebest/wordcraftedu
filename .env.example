# Text evaluator (choose one; DeepSeek is enough for sentence checking)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional custom-compatible DeepSeek endpoint, without /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Image studio (required for live GPT Image 2 generation)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
