# Agnes is preferred for both text evaluation and image generation.
AGNES_API_KEY=
AGNES_TEXT_MODEL=agnes-2.0-flash
AGNES_IMAGE_RESPONSE_FORMAT=url

# Optional text fallback
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional custom-compatible DeepSeek endpoint, without /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Image studio (Agnes is preferred; current Agnes Image Flash pricing is $0)
AGNES_IMAGE_MODEL=agnes-image-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
